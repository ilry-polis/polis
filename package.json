{
  "name": "polis",
  "version": "0.5.1",
  "description": "Multi-runtime plugin for coding agents: spec-driven development, behavior-focused TDD, durable context engineering, and token-efficient bounded subagent orchestration.",
  "license": "MIT",
  "keywords": ["claude-code", "codex", "cursor", "coding-agent", "context-engineering", "spec-driven-development", "tdd", "subagents"],
  "author": "",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "install:claude": "bash scripts/install.sh --runtime claude --scope project",
    "install:codex": "bash scripts/install.sh --runtime codex --scope project",
    "install:cursor": "bash scripts/install.sh --runtime cursor --scope project",
    "install:all": "bash scripts/install.sh --runtime all --scope project",
    "uninstall": "bash scripts/install.sh --uninstall"
  },
  "dependencies": {},
  "devDependencies": {}
}
